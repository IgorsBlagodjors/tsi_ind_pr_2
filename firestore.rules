rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(data) {
      return data.keys().hasAll([
          'fullName', 'email', 'phoneNumber', 'dateOfBirth',
          'gender', 'photoUrl', 'favoriteDoctorIds'
        ]) && data.keys().hasOnly([
          'fullName', 'email', 'phoneNumber', 'dateOfBirth',
          'gender', 'photoUrl', 'favoriteDoctorIds'
        ])
        && data.fullName is string && data.fullName.size() <= 200
        && data.email is string && data.email.size() <= 320
        && (data.phoneNumber == null ||
            (data.phoneNumber is string && data.phoneNumber.size() <= 50))
        && (data.dateOfBirth == null ||
            (data.dateOfBirth is string &&
             data.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (data.gender == null || data.gender in ['male', 'female', 'other'])
        && (data.photoUrl == null ||
            (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && data.favoriteDoctorIds is list && data.favoriteDoctorIds.size() <= 500;
    }

    match /users/{uid} {
      allow read: if ownsProfile(uid);
      allow create: if ownsProfile(uid)
        && validProfile(request.resource.data)
        && request.resource.data.email == request.auth.token.email;
      allow update: if ownsProfile(uid)
        && validProfile(request.resource.data)
        && request.resource.data.email == resource.data.email;
    }

    // Other collections stay private until their access rules are implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
