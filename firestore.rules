rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(data) {
      return data.keys().hasAll([
          'fullName', 'email', 'phoneNumber', 'dateOfBirth',
          'gender', 'photoUrl', 'favoriteDoctorIds'
        ]) && data.keys().hasOnly([
          'fullName', 'email', 'phoneNumber', 'dateOfBirth',
          'gender', 'photoUrl', 'favoriteDoctorIds'
        ])
        && data.fullName is string && data.fullName.size() <= 200
        && data.email is string && data.email.size() <= 320
        && (data.phoneNumber == null ||
            (data.phoneNumber is string && data.phoneNumber.size() <= 50))
        && (data.dateOfBirth == null ||
            (data.dateOfBirth is string &&
             data.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (data.gender == null || data.gender in ['male', 'female', 'other'])
        && (data.photoUrl == null ||
            (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && data.favoriteDoctorIds is list && data.favoriteDoctorIds.size() <= 500;
    }

    match /users/{uid} {
      allow read: if ownsProfile(uid);
      allow create: if ownsProfile(uid)
        && validProfile(request.resource.data)
        && request.resource.data.email == request.auth.token.email;
      allow update: if ownsProfile(uid)
        && validProfile(request.resource.data)
        && request.resource.data.email == resource.data.email;
    }

    match /doctors/{doctorId} {
      allow read: if request.auth != null;
      match /bookings/{slotId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['appointmentId', 'startsAt'])
          && request.resource.data.startsAt is timestamp
          && slotId == string(request.resource.data.startsAt.toMillis())
          && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.doctorId == doctorId
          && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.slotId == slotId;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.status == 'cancelled';
      }
    }
    match /appointments/{id} {
      allow read: if ownsProfile(resource.data.userId);
      allow create: if ownsProfile(request.resource.data.userId)
        && request.resource.data.keys().hasOnly(['userId', 'doctorId', 'slotId', 'startsAt', 'endsAt', 'createdAt', 'patient', 'status', 'cancelReason'])
        && exists(/databases/$(database)/documents/doctors/$(request.resource.data.doctorId))
        && request.resource.data.startsAt > request.time
        && request.resource.data.endsAt == request.resource.data.startsAt + duration.value(30, 'm')
        && request.resource.data.slotId == string(request.resource.data.startsAt.toMillis())
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'upcoming'
        && request.resource.data.cancelReason == null
        && validPatient(request.resource.data.patient)
        && !exists(/databases/$(database)/documents/doctors/$(request.resource.data.doctorId)/bookings/$(request.resource.data.slotId))
        && getAfter(/databases/$(database)/documents/doctors/$(request.resource.data.doctorId)/bookings/$(request.resource.data.slotId)).data.appointmentId == id;
      allow update: if ownsProfile(resource.data.userId)
        && resource.data.status == 'upcoming'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusChangedAt'])
        && request.resource.data.statusChangedAt == request.time
        && ((request.resource.data.status == 'completed' && resource.data.endsAt <= request.time)
          || (request.resource.data.status == 'cancelled' && resource.data.startsAt > request.time
            && !existsAfter(/databases/$(database)/documents/doctors/$(resource.data.doctorId)/bookings/$(resource.data.slotId))));
    }
    function validPatient(p) {
      return p.keys().hasOnly(['fullName', 'age', 'gender', 'isAccountOwner', 'problem'])
        && p.fullName is string && p.fullName.size() > 0 && p.fullName.size() <= 200
        && p.age is int && p.age >= 0 && p.age <= 120
        && p.gender in ['male', 'female', 'other']
        && p.isAccountOwner is bool && p.problem is string && p.problem.size() <= 2000;
    }

    // Other collections stay private until their access rules are implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
